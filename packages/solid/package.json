{
    "name": "@openrich/solid",
    "version": "1.0.0-next.1",
    "description": "SolidJS bindings for @openrich rich-text editor",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@openrich/core": "1.0.0-next.1"
    },
    "peerDependencies": {
        "solid-js": "^1.9.13"
    },
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    }
}
