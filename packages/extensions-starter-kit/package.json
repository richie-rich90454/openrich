{
  "name": "@openrich/starter-kit",
  "version": "0.1.1-next.0",
  "description": "Convenience bundle of all common @openrich extensions",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@openrich/extensions": "^0.1.1-next.0"
  },
  "peerDependencies": {
    "@openrich/core": "^0.1.1-next.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
