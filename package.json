{
  "name": "openrich",
  "private": true,
  "files": [],
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check packages/*/src playground/src",
    "lint:fix": "biome check --apply packages/*/src playground/src",
    "typecheck": "tsc --noEmit",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "enter-prerelease": "changeset pre enter",
    "publish:stable": "npm run changeset && npm run version-packages && npm run release",
    "publish:prerelease": "npm run enter-prerelease -- next && npm run changeset && npm run version-packages && npm run release"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@changesets/cli": "^2.31.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "solid-js": "^1.9.13",
    "svelte": "^5.55.9",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vue": "^3.5.35"
  },
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
