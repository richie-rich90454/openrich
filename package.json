{
    "name": "openrich",
    "private": true,
    "files": [],
    "workspaces": [
        "packages/*",
        "playground"
    ],
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "biome check packages/*/src playground/src",
        "lint:fix": "biome check --apply packages/*/src playground/src",
        "typecheck": "tsc --noEmit",
        "clean": "turbo run clean && rm -rf node_modules",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "turbo run build && changeset publish",
        "enter-prerelease": "changeset pre enter",
        "publish:stable": "npm run changeset && npm run version-packages && npm run release",
        "publish:prerelease": "npm run enter-prerelease -- next && npm run changeset && npm run version-packages && npm run release",
        "test": "vitest run",
        "test:watch": "vitest",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "format:js": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
        "format:html": "prettier --write \"**/*.html\"",
        "format:css": "prettier --write \"**/*.css\"",
        "format:json": "prettier --write \"**/*.json\"",
        "sync-deps": "syncpack fix"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.0",
        "@changesets/cli": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-vue": "^6.0.7",
        "happy-dom": "^20.9.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.8.3",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "solid-js": "^1.9.13",
        "svelte": "^5.55.9",
        "syncpack": "^15.3.1",
        "turbo": "^2.3.0",
        "typescript": "^5.7.0",
        "vite": "^6.4.3",
        "vitepress": "^1.6.4",
        "vitest": "^4.1.7",
        "vue": "^3.5.35"
    },
    "packageManager": "npm@10.8.0",
    "overrides": {
        "esbuild": ">=0.24.3"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
